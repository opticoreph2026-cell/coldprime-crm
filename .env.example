DATABASE_URL="postgresql://user:password@host:5432/dbname"

AUTH_SECRET="your-secret-here"
AUTH_ADMIN_EMAIL="admin@coldprime.ph"
AUTH_ADMIN_PASSWORD="your-password-here"

# Gmail SMTP (primary email sending — requires 2FA + App Password)
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="16-character-app-password"
EMAIL_FROM_NAME="Coldprime CRM"

# Soft daily send cap (Gmail free tier = 500/day; default 450)
# EMAIL_DAILY_CAP=450

# Cron auth for /api/emails/check-replies (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="generate-a-long-random-string"

# Resend fallback (requires verified domain)
RESEND_API_KEY="re_xxx"