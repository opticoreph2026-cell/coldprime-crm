DATABASE_URL="postgresql://user:password@host:5432/dbname"

AUTH_SECRET="your-secret-here"
AUTH_ADMIN_EMAIL="admin@coldprime.ph"
AUTH_ADMIN_PASSWORD="your-password-here"

# Gmail SMTP (primary email sending — requires 2FA + App Password)
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="16-character-app-password"
EMAIL_FROM_NAME="Coldprime CRM"

# Resend fallback (requires verified domain)
RESEND_API_KEY="re_xxx"